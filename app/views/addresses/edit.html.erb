<% if turbo_frame_request? %>
  <%= turbo_frame_tag "modal" do %>
    <div class="form-page">
      <div class="form-page-header"><%= link_to addresses_path, class: "back-button", aria: { label: "Back to Addresses" } do %>←<% end %><div><h1>Edit Address</h1><p>Update this address in the system</p></div></div>
      <div class="form-card">
        <%= render "shared/form_errors", record: @address %>
        <%= form_with url: address_path(@address.id), method: :patch, local: true do |f| %>
          <div class="form-field"><%= f.label :name, "Name", class: "form-label" %><div class="input-with-icon"><span class="field-icon">♙</span><%= text_field_tag "address[name]", @address.name, class: "form-control", placeholder: "Enter name", required: true %></div></div>
          <div class="form-field"><%= label_tag "address[home_address]", "Home Address", class: "form-label" %><div class="input-with-icon"><span class="field-icon">⌂</span><%= text_field_tag "address[home_address]", @address.home_address, class: "form-control", placeholder: "Enter home address", required: true %></div></div>
          <div class="form-field"><%= label_tag "address[work_address]", "Work Address", class: "form-label" %><div class="input-with-icon"><span class="field-icon">⌂</span><%= text_field_tag "address[work_address]", @address.work_address, class: "form-control", placeholder: "Enter work address", required: true %></div></div>
          <div class="form-field"><%= label_tag "address[street_address]", "Street Address", class: "form-label" %><div class="input-with-icon"><span class="field-icon">⌂</span><%= text_field_tag "address[street_address]", @address.street_address, class: "form-control", placeholder: "Enter street address", required: true %></div></div>
          <div class="form-field"><%= label_tag "address[city_name]", "City Name", class: "form-label" %><div class="input-with-icon"><span class="field-icon">⌖</span><%= text_field_tag "address[city_name]", @address.city_name, class: "form-control", placeholder: "Enter city name", required: true %></div></div>
          <div class="form-actions"><%= link_to "Cancel", addresses_path, class: "secondary-button" %><%= f.submit "Update Address", class: "primary-button" %></div>
        <% end %>
      </div>
    </div>
  <% end %>
<% else %>
  <div class="form-page">
    <div class="form-page-header"><%= link_to addresses_path, class: "back-button", aria: { label: "Back to Addresses" } do %>←<% end %><div><h1>Edit Address</h1><p>Update this address in the system</p></div></div>
    <div class="form-card">
      <%= render "shared/form_errors", record: @address %>
      <%= form_with url: address_path(@address.id), method: :patch, local: true do |f| %>
        <div class="form-field"><%= f.label :name, "Name", class: "form-label" %><div class="input-with-icon"><span class="field-icon">♙</span><%= text_field_tag "address[name]", @address.name, class: "form-control", placeholder: "Enter name", required: true %></div></div>
        <div class="form-field"><%= label_tag "address[home_address]", "Home Address", class: "form-label" %><div class="input-with-icon"><span class="field-icon">⌂</span><%= text_field_tag "address[home_address]", @address.home_address, class: "form-control", placeholder: "Enter home address", required: true %></div></div>
        <div class="form-field"><%= label_tag "address[work_address]", "Work Address", class: "form-label" %><div class="input-with-icon"><span class="field-icon">⌂</span><%= text_field_tag "address[work_address]", @address.work_address, class: "form-control", placeholder: "Enter work address", required: true %></div></div>
        <div class="form-field"><%= label_tag "address[street_address]", "Street Address", class: "form-label" %><div class="input-with-icon"><span class="field-icon">⌂</span><%= text_field_tag "address[street_address]", @address.street_address, class: "form-control", placeholder: "Enter street address", required: true %></div></div>
        <div class="form-field"><%= label_tag "address[city_name]", "City Name", class: "form-label" %><div class="input-with-icon"><span class="field-icon">⌖</span><%= text_field_tag "address[city_name]", @address.city_name, class: "form-control", placeholder: "Enter city name", required: true %></div></div>
        <div class="form-actions"><%= link_to "Cancel", addresses_path, class: "secondary-button" %><%= f.submit "Update Address", class: "primary-button" %></div>
      <% end %>
    </div>
  </div>
<% end %>
