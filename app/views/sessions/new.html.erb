<main class="auth-card">
  <div class="auth-mark">A</div>
  <h1>Welcome back</h1>
  <p>Sign in to manage your records.</p>
  <% if flash[:alert] %><div class="form-alert" role="alert"><%= flash[:alert] %></div><% end %>
  <%= form_with url: sign_in_path, method: :post, local: true do %>
    <div class="auth-field"><%= label_tag :username, "Username" %><%= text_field_tag :username, params[:username], autocomplete: "username", required: true, autofocus: true %></div>
    <div class="auth-field"><%= label_tag :password, "Password" %><%= password_field_tag :password, nil, autocomplete: "current-password", required: true %></div>
    <%= submit_tag "Sign in", class: "auth-submit" %>
  <% end %>
  <%= link_to "Create an account", create_account_path, class: "auth-link" %>
</main>