<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Todo App" %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Todo App">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div class="dashboard-shell">
      <aside class="sidebar">
        <div class="brand-box">
          <%= image_tag "logo_white_blue (1).png", class: "brand-mark", alt: "A logo" %>
        </div>

        <nav class="sidebar-nav">
          <%= link_to tasks_path, class: "nav-item #{'active' if current_page?(tasks_path)}" do %>
            <span class="nav-icon">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 4.75A2.75 2.75 0 0 1 7.75 2h8.5A2.75 2.75 0 0 1 19 4.75v14.5A2.75 2.75 0 0 1 16.25 22h-8.5A2.75 2.75 0 0 1 5 19.25V4.75Zm2.75-.25a.75.75 0 0 0-.75.75v14.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75V5.25a.75.75 0 0 0-.75-.75h-8.5Zm2.25 3.5h4.5a.75.75 0 0 1 0 1.5h-4.5a.75.75 0 0 1 0-1.5Zm0 4h4.5a.75.75 0 0 1 0 1.5h-4.5a.75.75 0 0 1 0-1.5Zm0 4h3.5a.75.75 0 0 1 0 1.5h-3.5a.75.75 0 0 1 0-1.5Z" fill="currentColor"/></svg>
            </span>
            <span>Dashboard</span>
          <% end %>

          <%= link_to tasks_path, class: "nav-item #{'active' if current_page?(tasks_path)}" do %>
            <span class="nav-icon">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 5.75A2.75 2.75 0 0 1 9.75 3h4.5A2.75 2.75 0 0 1 17 5.75v12.5A2.75 2.75 0 0 1 14.25 21h-4.5A2.75 2.75 0 0 1 7 18.25V5.75Zm2.75-.25a.75.75 0 0 0-.75.75v12.5c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75V6.25a.75.75 0 0 0-.75-.75h-4.5ZM10 8.5h4v1.5h-4V8.5Zm0 3h4v1.5h-4v-1.5Zm0 3h3v1.5h-3v-1.5Z" fill="currentColor"/></svg>
            </span>
            <span>Bio Data</span>
          <% end %>

          <%= link_to addresses_path, class: "nav-item #{'active' if current_page?(addresses_path)}" do %>
            <span class="nav-icon">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 2.75a7.75 7.75 0 0 1 7.75 7.75c0 5.94-7.75 11.5-7.75 11.5S4.25 16.44 4.25 10.5A7.75 7.75 0 0 1 12 2.75Zm0 2a5.75 5.75 0 0 0-5.75 5.75c0 3.82 4.13 7.75 5.75 8.85 1.62-1.1 5.75-5.03 5.75-8.85A5.75 5.75 0 0 0 12 4.75Zm0 2.25a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7Z" fill="currentColor"/></svg>
            </span>
            <span>Location</span>
          <% end %>

          <%= link_to regions_path, class: "nav-item #{'active' if current_page?(regions_path)}" do %>
            <span class="nav-icon">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M3 5.75A2.75 2.75 0 0 1 5.75 3h12.5A2.75 2.75 0 0 1 21 5.75v12.5A2.75 2.75 0 0 1 18.25 21H5.75A2.75 2.75 0 0 1 3 18.25V5.75Zm2.75-.25a.75.75 0 0 0-.75.75v12.5c0 .414.336.75.75.75h12.5a.75.75 0 0 0 .75-.75V6.25a.75.75 0 0 0-.75-.75H5.75Zm1.5 2.5h9.5a.75.75 0 0 1 0 1.5h-9.5a.75.75 0 0 1 0-1.5Zm0 4h9.5a.75.75 0 0 1 0 1.5h-9.5a.75.75 0 0 1 0-1.5Zm0 4h6.5a.75.75 0 0 1 0 1.5h-6.5a.75.75 0 0 1 0-1.5Z" fill="currentColor"/></svg>
            </span>
            <span>Regions</span>
          <% end %>

          <%= link_to cities_path, class: "nav-item #{'active' if current_page?(cities_path)}" do %>
            <span class="nav-icon">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 19.5V7.75A2.75 2.75 0 0 1 6.75 5h10.5A2.75 2.75 0 0 1 20 7.75v11.75h-2.5V7.75a.25.25 0 0 0-.25-.25H6.75a.25.25 0 0 0-.25.25V19.5H4Zm3-8.5h2.5v2.5H7v-2.5Zm4.5 0h2.5v2.5h-2.5v-2.5Zm4.5 0h2.5v2.5h-2.5v-2.5Zm-9 4h2.5v2.5H7v-2.5Zm4.5 0h2.5v2.5h-2.5v-2.5Zm4.5 0h2.5v2.5h-2.5v-2.5Z" fill="currentColor"/></svg>
            </span>
            <span>Cities</span>
          <% end %>

          <%= link_to recycle_bin_path, class: "nav-item #{'active' if current_page?(recycle_bin_path)}" do %>
            <span class="nav-icon" aria-hidden="true">&#9851;</span>
            <span>Recycle Bin</span>
          <% end %>
        </nav>

        <div class="sidebar-card">
          <div class="sidebar-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm6.92 9h-3.01a15.7 15.7 0 0 0-1.1-5.04A8.04 8.04 0 0 1 18.92 11ZM12 4c.75 1.05 1.5 2.84 1.82 7h-3.64c.32-4.16 1.07-5.95 1.82-7ZM9.19 5.96A15.7 15.7 0 0 0 8.09 11H5.08a8.04 8.04 0 0 1 4.11-5.04ZM5.08 13h3.01c.12 1.86.5 3.63 1.1 5.04A8.04 8.04 0 0 1 5.08 13ZM12 20c-.75-1.05-1.5-2.84-1.82-7h3.64c-.32 4.16-1.07 5.95-1.82 7Zm2.81-1.96c.6-1.41.98-3.18 1.1-5.04h3.01a8.04 8.04 0 0 1-4.11 5.04Z" fill="currentColor"/></svg>
          </div>
          <div class="sidebar-card-title">Manage locations</div>
          <div class="sidebar-card-subtitle">Organize regions and cities efficiently</div>
          <%= link_to "Learn more", '#', class: "sidebar-card-link" %>
        </div>
      </aside>

      <main class="main-panel">
        <header class="topbar">
          <div class="search-box">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M10.5 3a7.5 7.5 0 1 1 4.93 13.08l4.72 4.73a1 1 0 0 1-1.41 1.42l-4.73-4.72A7.5 7.5 0 0 1 10.5 3Zm0 2a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11Z" fill="currentColor"/></svg>
            <input type="search" data-table-search placeholder="Search this page..." aria-label="Search this page" />
          </div>

          <div class="user-box">
            <div class="notification-menu" data-notification-menu>
              <button class="topbar-button" type="button" aria-label="Notifications" aria-expanded="false" aria-controls="notification-panel" data-notification-toggle>
                <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9Zm-8.25 11h4.5a2.25 2.25 0 0 1-4.5 0Z" fill="currentColor"/></svg>
                <span class="notification-dot" data-notification-dot></span>
              </button>
              <section class="notification-panel" id="notification-panel" hidden data-notification-panel aria-label="Notifications">
                <div class="notification-header">
                  <h2>Notifications</h2>
                  <button type="button" class="notification-clear" data-notification-clear>Mark all read</button>
                </div>
                <a class="notification-item" href="<%= tasks_path %>">
                  <span class="notification-item-icon blue">&#10003;</span>
                  <span><strong>Task records ready</strong><small><%= Task.all.count %> records available to review</small></span>
                </a>
                <a class="notification-item" href="<%= addresses_path %>">
                  <span class="notification-item-icon orange">&#9679;</span>
                  <span><strong>Address book updated</strong><small><%= Address.all.count %> saved locations</small></span>
                </a>
                <a class="notification-item" href="<%= cities_path %>">
                  <span class="notification-item-icon green">&#8599;</span>
                  <span><strong>Locations available</strong><small><%= City.all.count %> cities across your regions</small></span>
                </a>
                <p class="notification-empty" data-notification-empty hidden>You're all caught up.</p>
              </section>
            </div>
            <div class="profile-menu" data-profile-menu>
              <button class="user-badge" type="button" aria-expanded="false" aria-controls="profile-panel" data-profile-toggle>
                <div class="user-avatar" data-profile-avatar>A</div>
                <span class="user-meta">
                  <span class="user-name" data-profile-name>Admin User</span>
                  <span class="user-role">Administrator</span>
                </span>
              </button>
              <section class="profile-panel" id="profile-panel" hidden data-profile-panel aria-label="Admin profile settings">
                <h2>Admin profile</h2>
                <label for="profile-name-input">Name</label>
                <input id="profile-name-input" type="text" maxlength="32" value="Admin User" data-profile-name-input>
                <label for="profile-avatar-input">Avatar</label>
                <input id="profile-avatar-input" type="text" maxlength="2" value="A" data-profile-avatar-input>
                <span class="profile-label">Choose an avatar</span>
                <div class="profile-avatars" role="group" aria-label="Choose an avatar">
                  <button type="button" class="profile-avatar-choice" data-profile-avatar-choice="A">A</button>
                  <button type="button" class="profile-avatar-choice" data-profile-avatar-choice="B">B</button>
                  <button type="button" class="profile-avatar-choice" data-profile-avatar-choice="C">C</button>
                  <button type="button" class="profile-avatar-choice" data-profile-avatar-choice="★">★</button>
                  <button type="button" class="profile-avatar-choice" data-profile-avatar-choice="◆">◆</button>
                  <button type="button" class="profile-avatar-choice" data-profile-avatar-choice="✦">✦</button>
                  <button type="button" class="profile-avatar-choice" data-profile-avatar-choice="☀">☀</button>
                  <button type="button" class="profile-avatar-choice" data-profile-avatar-choice="♥">♥</button>
                </div>
                <span class="profile-label">Avatar color</span>
                <div class="profile-colors" role="group" aria-label="Avatar color">
                  <button type="button" class="profile-color blue" aria-label="Blue" data-profile-color="#2476d8"></button>
                  <button type="button" class="profile-color orange" aria-label="Orange" data-profile-color="#d78d4d"></button>
                  <button type="button" class="profile-color green" aria-label="Green" data-profile-color="#2ca66b"></button>
                  <button type="button" class="profile-color red" aria-label="Red" data-profile-color="#d9485a"></button>
                  <button type="button" class="profile-color purple" aria-label="Purple" data-profile-color="#7655c7"></button>
                  <button type="button" class="profile-color teal" aria-label="Teal" data-profile-color="#149b9b"></button>
                  <button type="button" class="profile-color pink" aria-label="Pink" data-profile-color="#d65391"></button>
                  <button type="button" class="profile-color navy" aria-label="Navy" data-profile-color="#263f73"></button>
                  <button type="button" class="profile-color lime" aria-label="Lime" data-profile-color="#72a832"></button>
                </div>
                <%= link_to "Edit profile", user_path, class: "profile-link" %>
                <%= link_to "Sign out", sign_out_path, data: { turbo_method: :delete }, class: "profile-link" %>
                <button type="button" class="profile-save" data-profile-save>Save profile</button>
              </section>
            </div>
          </div>
        </header>

        <div class="content-area">
          <%= yield %>
        </div>
      </main>
    </div>

    <div class="confirm-modal" data-confirm-modal hidden>
      <div class="confirm-backdrop" data-confirm-cancel></div>
      <section class="confirm-dialog" role="alertdialog" aria-modal="true" aria-labelledby="confirm-title" aria-describedby="confirm-message">
        <div class="confirm-icon">!</div>
        <h2 id="confirm-title">Confirm deletion</h2>
        <p id="confirm-message" data-confirm-message></p>
        <div class="confirm-actions">
          <button type="button" class="confirm-cancel" data-confirm-cancel>Cancel</button>
          <button type="button" class="confirm-submit" data-confirm-submit>Delete</button>
        </div>
      </section>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  </body>
</html>
