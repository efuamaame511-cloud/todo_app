<main class="auth-card">
  <div class="auth-mark">+</div>
  <h1>Create account</h1>
  <p>Create an account before accessing the admin dashboard.</p>
  <% if flash[:alert] %><div class="form-alert" role="alert"><%= flash[:alert] %></div><% end %>
  <%= form_with url: create_account_path, method: :post, local: true do %>
    <div class="auth-field"><%= label_tag :username, "Username" %><%= text_field_tag :username, params[:username], autocomplete: "username", required: true, autofocus: true %></div>
    <div class="auth-field"><%= label_tag :password, "Password" %><%= password_field_tag :password, nil, autocomplete: "new-password", required: true %></div>
    <%= submit_tag "Create account", class: "auth-submit" %>
  <% end %>
  <%= link_to "Back to sign in", sign_in_path, class: "auth-link" %>
</main>