<div class="profile-page">
  <div class="profile-page-header">
    <div><h1>User profile</h1><p>Update the identity shown in the admin area.</p></div>
    <%= link_to "Back to dashboard", root_path, class: "outline-button" %>
  </div>
  <div class="profile-card">
    <% if flash[:alert] %><div class="form-alert" role="alert"><%= flash[:alert] %></div><% end %>
    <%= form_with url: user_path, method: :patch, local: true do %>
      <div class="form-field"><%= label_tag :username, "Name", class: "form-label" %><%= text_field_tag :username, @user[:username], class: "form-control", maxlength: 32, required: true %></div>
      <div class="form-field"><%= label_tag :avatar, "Avatar", class: "form-label" %><%= text_field_tag :avatar, @user[:avatar], class: "form-control", maxlength: 2, required: true %></div>
      <div class="form-field"><%= label_tag :color, "Avatar color", class: "form-label" %><%= color_field_tag :color, @user[:color], class: "profile-color-input" %></div>
      <div class="form-actions"><%= link_to "Cancel", root_path, class: "secondary-button" %><%= submit_tag "Save profile", class: "primary-button" %></div>
    <% end %>
  </div>
</div>