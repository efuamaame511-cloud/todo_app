<% if record.errors.any? %>
  <div class="form-alert" role="alert">
    <strong><%= record.errors.full_messages.any? { |message| message.downcase.include?("already") || message.downcase.include?("used") } ? "This record is already created." : "Please correct the highlighted details." %></strong>
    <span><%= record.errors.full_messages.to_sentence %></span>
  </div>
<% end %>
